# Copy to .env for local development, or set these in your host's dashboard.

# Generate with:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me

# Must be False in production.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,surajportfolio.com,www.surajportfolio.com

# Leave unset locally to use SQLite. In production use a Postgres URL, e.g. from Neon:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Email notifications (optional) -------------------------------
# Contact messages are always saved to the database. Set these to also get an
# email when one arrives. Leave EMAIL_HOST unset and emails print to the console.

# Where notifications are sent:
CONTACT_NOTIFY_EMAIL=surajpande20554@gmail.com
DEFAULT_FROM_EMAIL=portfolio@surajportfolio.com

# Gmail (needs a 16-character App Password, not your normal password):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=surajpande20554@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_USE_TLS=True

# Resend (free tier, better deliverability):
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_your_api_key

# --- GitHub stats (optional) --------------------------------------
# Without a token you get 60 API requests per hour, which is plenty for a few
# repos. A token (no scopes needed for public repos) raises it to 5,000.
# GITHUB_TOKEN=ghp_your_token
